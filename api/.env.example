# api/.env.example — kopyala: cp .env.example .env
# .env ASLA commit edilmez.

# Yerel geliştirme
DATABASE_URL=postgresql://localhost/nobet_zekasi

# Neon (üretim): pooled bağlantı + sslmode=require
# DATABASE_URL=postgresql://KULLANICI:PAROLA@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

DB_POOL_MIN=1
DB_POOL_MAX=10

# 'stub' referans haftayı kopyalar, 'cpsat' gerçek çözücü
SOLVER_IMPL=stub
SOLVER_TIME_LIMIT_S=60

# CP-SAT işçi sayısı — makinenin vCPU sayısını AŞMAMALI (fazlası yavaşlatır)
SOLVER_WORKERS=8

# Aynı anda kaç taslak çözülebilir. 1 = ikinci istek 409 alır.
SOLVER_MAX_CONCURRENT=1

# 'production' iken /docs, /redoc ve /openapi.json kapatılır
ENVIRONMENT=development

# Web proxy'sinin gönderdiği ortak anahtar. Boşsa doğrulama kapalı (yerel).
DEMO_API_TOKEN=
