# web/.env.example — kopyala: cp .env.example .env.local
# .env.local ASLA commit edilmez.

# FastAPI adresi. Yerelde localhost, canlıda Railway URL'i.
API_BASE_URL=http://localhost:8000

# API'nin beklediği ortak anahtar. Sunucuda kalır, tarayıcıya inmez.
DEMO_API_TOKEN=

# Demo giriş şifresi. Boş bırakılırsa koruma kapalı (yerel geliştirme).
DEMO_PASSWORD=
